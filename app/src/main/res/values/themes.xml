        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/damn_accent</item>
        <item name="android:statusBarColor">@color/damn_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Dialog Styling -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DAMN.Dialog</item>
    </style>

    <style name="ThemeOverlay.DAMN.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/damn_card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/damn_accent</item>
    </style>
</resources>

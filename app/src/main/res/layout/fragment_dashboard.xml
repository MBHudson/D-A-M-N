<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/damn_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Banner — EXACT match to Home (no settings icon, no status indicator) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/damn_card"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle_prefixed"
                    android:textColor="@color/damn_accent"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:alpha="0.8" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/fullscreenBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="@color/damn_accent"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Toggle Fullscreen" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Routing Path — S layout — directly after banner (stats section removed) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/damn_card"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/routingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#0B1220"
                android:padding="8dp"
                android:clipChildren="true"
                android:clipToPadding="false">

                <HorizontalScrollView
                    android:id="@+id/chartScroll"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:overScrollMode="never">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/zoomContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:transformPivotX="0dp"
                            android:transformPivotY="0dp">

                        <com.damn.app.ui.SPathView
                            android:id="@+id/sPathView"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@id/rowsContainer"
                            app:layout_constraintEnd_toEndOf="@id/rowsContainer"
                            app:layout_constraintStart_toStartOf="@id/rowsContainer"
                            app:layout_constraintTop_toTopOf="@id/rowsContainer" />

                        <LinearLayout
                            android:id="@+id/rowsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:id="@+id/topRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/midRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingVertical="6dp" />

                            <LinearLayout
                                android:id="@+id/bottomRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />
                        </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.core.widget.NestedScrollView>
                </HorizontalScrollView>

                <!-- Zoom Controls -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_margin="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zoomOutBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="0dp"
                        android:text="-"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp"
                        app:backgroundTint="#1E293B"
                        android:textColor="@color/damn_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zoomInBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:padding="0dp"
                        android:text="+"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp"
                        app:backgroundTint="#1E293B"
                        android:textColor="@color/damn_accent" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Traffic card — combined Traffic + Ping History (single graph) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/damn_card"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="IN" android:textColor="#94A3B8" android:textSize="11sp" />
                    <TextView android:id="@+id/inVal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#38BDF8" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="4dp" />
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OUT" android:textColor="#94A3B8" android:textSize="11sp" />
                    <TextView android:id="@+id/outVal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#818CF8" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- Combined graph: Ping History (taller) + Traffic spark -->
                <com.damn.app.ui.PingChartView
                    android:id="@+id/pingChart"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp" />

                <com.damn.app.ui.TrafficSparkView
                    android:id="@+id/trafficSpark"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp" />

                <!-- Legend centered between 60s window and req/s — fixed widths to lock position -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="60s window" android:textColor="#64748B" android:textSize="10sp"
                        android:gravity="start" />
                    <LinearLayout android:id="@+id/pingLegend"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="4dp" />
                    <TextView android:id="@+id/tpsVal" android:layout_width="72dp" android:layout_height="wrap_content"
                        android:text="0 req/s" android:textColor="#64748B" android:textSize="10sp"
                        android:gravity="end" android:minWidth="64dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="10dp"
                        android:layout_marginEnd="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Down" android:textColor="#64748B" android:textSize="10sp" android:letterSpacing="0.06" />
                        <TextView android:id="@+id/downVal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                        <ProgressBar android:id="@+id/downBar" style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="6dp"
                            android:max="100" android:progress="0"
                            android:progressTint="#38BDF8" android:progressBackgroundTint="#0F172A"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="10dp"
                        android:layout_marginStart="5dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Up" android:textColor="#64748B" android:textSize="10sp" android:letterSpacing="0.06" />
                        <TextView android:id="@+id/upVal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                        <ProgressBar android:id="@+id/upBar" style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="6dp"
                            android:max="100" android:progress="0"
                            android:progressTint="#22C55E" android:progressBackgroundTint="#0F172A"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedBtn"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Run Speed Test"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button"
                    android:layout_marginTop="10dp" />

                <TextView android:id="@+id/speedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tests best tunnel automatically"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
